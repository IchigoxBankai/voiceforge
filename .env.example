# VoiceForge Environment Configuration Example
# Copy to .env in client and server, or respective directories

# ==========================================
# Client Configuration (.env in /client)
# ==========================================
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
VITE_API_BASE_URL=http://localhost:5000/api

# ==========================================
# Server Configuration (.env in /server)
# ==========================================
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Supabase Admin / Service Role
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# AI Provider API Keys
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Audio Storage Local Fallback directory (when Supabase Storage not configured)
STORAGE_MODE=supabase
MAX_AUDIO_UPLOAD_MB=25

